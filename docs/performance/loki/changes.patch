-        self.entries.borrow_mut().insert(e, solved);
+        let mut entries = self.entries.borrow_mut();
+        if let Some((_, value)) = entries.iter_mut().find(|(key, _)| key == &e) {
+            *value = solved;
+        } else {
+            entries.push((e, solved));
+        }
     }
