 impl LinearCache for LocalCache {
     fn get(&self, e: &Expr) -> Option<Expr> {
-        self.entries.borrow().get(e).cloned()
+        self.entries
+            .borrow()
+            .iter()
+            .find(|(key, _)| key == e)
